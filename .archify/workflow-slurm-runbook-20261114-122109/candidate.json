  "cards": [
    { "dot": "cyan", "title": "How runs are wired", "items": [
      "Each job writes runs/$SLURM_JOB_ID/; the next job is pointed at it with an exported *_DIR variable",
      "T12 and T7 refuse to start without their required *_DIR (bash ${VAR:?})",
      "T3, T4 and T5 dirs default to the accepted runs 2242278, 2242423 and 2242438"
    ] },
    { "dot": "amber", "title": "T5 chain", "items": [
      "t5_submit.sh submits prepare, then a 32-stripe array (max 30 at once), then merge",
      "Each step depends on the previous with --dependency=afterok",
      "All three steps share the prepare job's run directory"
    ] },
    { "dot": "rose", "title": "Guardrails", "items": [
      "Nothing heavy runs on the login node; every step is sbatch on the cpu partition",
      "export.py exits 1 when any hard check fails, so the job is marked failed",
      "Copying into app/public/data is a separate manual step"
    ] }
  ]
