  "cards": [
    { "dot": "emerald", "title": "Same measurement everywhere", "items": [
      "Moon, Mars and Earth are cut into the same 32 km patches at 500 m per pixel",
      "One shared feature function makes slope and roughness comparable across bodies"
    ] },
    { "dot": "cyan", "title": "How stages connect", "items": [
      "Each stage saves its results; later stages read the accepted earlier results",
      "The Earth sweep runs in parallel chunks and merges them before checks",
      "Context layers are sampled at the same patch and target locations"
    ] },
    { "dot": "rose", "title": "Quality gate", "items": [
      "Export runs hard and soft checks and writes a report",
      "Any failed hard check rejects the run, so the dataset is not published"
