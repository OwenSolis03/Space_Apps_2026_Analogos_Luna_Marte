  "cards": [
    { "dot": "cyan", "title": "Batch side", "items": [
      "Heavy processing runs offline as batch jobs on a compute cluster",
      "Each run writes its own output folder; later stages read the accepted earlier runs",
      "Matching and export run together and produce one dataset file"
    ] },
    { "dot": "emerald", "title": "Static side", "items": [
      "The web app has no backend: it loads one JSON file",
      "Scores are recomputed in the browser when the reader changes weights",
      "Publishing is a deliberate, reviewed copy, so a run never edits the app by itself"
    ] },
