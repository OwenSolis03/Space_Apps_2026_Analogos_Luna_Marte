  "cards": [
    { "dot": "emerald", "title": "One measurement on three bodies", "items": [
      "Every patch is 64 × 64 px at 500 m/px (32 km) in a local azimuthal equidistant projection",
      "One shared compute_features() gives slope, relief, hypsometry, roughness and TRI",
      "Elevation is never compared, because the datums differ"
    ] },
    { "dot": "cyan", "title": "Edges not drawn", "items": [
      "T12, T13 and T14 also sample at T3, T4 and T5 patch coordinates",
      "T12 reads full features_earth (LST) and T3 Moon Diviner temperatures",
      "match.py reads T3 Mars themis_delta; export.py re-reads T4, T5 and the layers"
    ] },
    { "dot": "amber", "title": "Hand-written inputs", "items": [
      "pipeline/data/targets.json → T4 curated targets",
      "geology_overrides.json → T14; ice_hints.json → T12",
      "limits.json → export (falls back to sample.json limits)"
    ] }
